 {
  "type": "embed",
  "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap');\n  .tdt-root {\n    font-family: 'Barlow', sans-serif;\n    background: #F1EFEA;\n    color: #1a1a18;\n    padding: 32px 28px;\n    max-width: 100%;\n    box-sizing: border-box;\n  }\n  .tdt-tabs { display: flex; gap: 4px; margin-bottom: 28px; }\n  .tdt-tab {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 13px; font-weight: 700; letter-spacing: 0.08em;\n    padding: 6px 18px; border: none; cursor: pointer;\n    transition: background 0.15s, color 0.15s;\n    background: #d6d2c8; color: #6b6860;\n    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 100%, 6px 100%);\n  }\n  .tdt-tab.active { background: #e8620a; color: #fff; }\n  .tdt-tab:hover:not(.active) { background: #c4bfb4; color: #1a1a18; }\n  .tdt-section { margin-bottom: 26px; }\n  .tdt-section-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }\n  .tdt-section-icon { width: 36px; height: 36px; background: #e8620a; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n  .tdt-section-icon svg { width: 20px; height: 20px; fill: #fff; }\n  .tdt-section-title { font-family: 'Barlow Condensed', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #1a1a18; }\n  .tdt-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\n  .tdt-table thead tr { background: #2a2a26; color: #fff; }\n  .tdt-table thead th { padding: 7px 10px; font-weight: 600; text-align: center; white-space: nowrap; font-size: 11px; letter-spacing: 0.04em; }\n  .tdt-table thead th:first-child { text-align: left; }\n  .tdt-table tbody tr { border-bottom: 1px solid #ddd9d0; transition: background 0.1s; }\n  .tdt-table tbody tr:nth-child(even) { background: #ede9e2; }\n  .tdt-table tbody tr:hover { background: #fde8d6; }\n  .tdt-table tbody td { padding: 7px 10px; text-align: center; color: #333; }\n  .tdt-table tbody td:first-child { text-align: left; font-weight: 600; color: #1a1a18; }\n  .tdt-bit-group td {\n    font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700;\n    letter-spacing: 0.08em; text-transform: uppercase;\n    background: rgba(232,98,10,0.12) !important; color: #b84a04;\n    padding: 4px 10px; border-left: 3px solid #e8620a; text-align: left !important;\n  }\n  .tdt-note { font-size: 11px; color: #666; text-align: left !important; }\n  .tdt-app { text-align: left !important; font-size: 11.5px; color: #555; }\n  .tdt-empty { text-align: center; padding: 16px; color: #aaa; font-size: 13px; font-style: italic; }\n</style><div class=\"tdt-root\"><div class=\"tdt-tabs\"><button class=\"tdt-tab active\">R25</button><button class=\"tdt-tab\">R32</button><button class=\"tdt-tab\">R38</button><button class=\"tdt-tab\">R51</button></div><div class=\"tdt-section\"><div class=\"tdt-section-header\"><div class=\"tdt-section-icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"10\" width=\"18\" height=\"4\" rx=\"2\"></rect><rect x=\"9\" y=\"7\" width=\"6\" height=\"10\" rx=\"1\" opacity=\".5\"></rect></svg></div><span class=\"tdt-section-title\">Hollow Anchor Bar</span></div><table class=\"tdt-table\"><thead><tr><th>Size</th><th>Outer Dia. (mm)</th><th>Ultimate Load (kN)</th><th>Yield Load (kN)</th><th>Weight (kg/m)</th></tr></thead><tbody><tr><td>SER25N</td><td>25</td><td>200</td><td>150</td><td>2.35</td></tr></tbody></table></div><div class=\"tdt-section\"><div class=\"tdt-section-header\"><div class=\"tdt-section-icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"9\" width=\"20\" height=\"6\" rx=\"3\"></rect><rect x=\"7\" y=\"7\" width=\"4\" height=\"10\" rx=\"1\" opacity=\".6\"></rect><rect x=\"13\" y=\"7\" width=\"4\" height=\"10\" rx=\"1\" opacity=\".6\"></rect></svg></div><span class=\"tdt-section-title\">Coupler</span></div><table class=\"tdt-table\"><thead><tr><th>Size</th><th>Outer Dia. (mm)</th><th>Length (mm)</th><th>Weight (kg/pc)</th><th>Note</th></tr></thead><tbody><tr><td>SSR25</td><td>36</td><td>150</td><td>0.66</td><td class=\"tdt-note\">With sealing structure</td></tr><tr><td>SER25</td><td>36</td><td>150</td><td>0.68</td><td class=\"tdt-note\">Without sealing structure</td></tr></tbody></table></div><div class=\"tdt-section\"><div class=\"tdt-section-header\"><div class=\"tdt-section-icon\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 20,7 20,17 12,22 4,17 4,7\"></polygon><circle cx=\"12\" cy=\"12\" r=\"3.5\" fill=\"#e8620a\"></circle></svg></div><span class=\"tdt-section-title\">Hex Nut</span></div><table class=\"tdt-table\"><thead><tr><th>Size</th><th>Key Size (mm)</th><th>Length (mm)</th><th>Weight (kg/pc)</th><th>Note</th></tr></thead><tbody><tr><td>SSR25</td><td>41</td><td>30</td><td>0.2</td><td class=\"tdt-note\">Heat treatment</td></tr><tr><td>SER25</td><td>41</td><td>35</td><td>0.23</td><td class=\"tdt-note\">Without heat treatment</td></tr></tbody></table></div><div class=\"tdt-section\"><div class=\"tdt-section-header\"><div class=\"tdt-section-icon\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 20,7 20,17 12,22 4,17 4,7\"></polygon><circle cx=\"12\" cy=\"12\" r=\"3.5\" fill=\"#e8620a\"></circle></svg></div><span class=\"tdt-section-title\">Domed Nut</span></div><table class=\"tdt-table\"><thead><tr><th>Size</th><th>Key Size (mm)</th><th>Length (mm)</th><th>Weight (kg/pc)</th><th>Note</th></tr></thead><tbody><tr><td>SER25</td><td>41</td><td>40.5</td><td>0.31</td><td class=\"tdt-note\">Without heat treatment</td></tr></tbody></table></div><div class=\"tdt-section\"><div class=\"tdt-section-header\"><div class=\"tdt-section-icon\"><svg viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"1\"></rect><circle cx=\"12\" cy=\"12\" r=\"2.5\" fill=\"#e8620a\"></circle></svg></div><span class=\"tdt-section-title\">Domed Plate</span></div><table class=\"tdt-table\"><thead><tr><th>Size</th><th>Dimensions (mm)</th><th>Thickness (mm)</th><th>Hole Dia. (mm)</th><th>Weight (kg/pc)</th></tr></thead><tbody><tr><td>SER25</td><td>150×150</td><td>8</td><td>30</td><td>1.4</td></tr><tr><td></td><td>150×150</td><td>5</td><td>28</td><td>0.85</td></tr><tr><td></td><td>200×200</td><td>10</td><td>32</td><td>3.2</td></tr></tbody></table></div><div class=\"tdt-section\"><div class=\"tdt-section-header\"><div class=\"tdt-section-icon\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,3 21,9 18,20 6,20 3,9\"></polygon><circle cx=\"12\" cy=\"13\" r=\"3\" fill=\"#e8620a\"></circle></svg></div><span class=\"tdt-section-title\">Drill Bit</span></div><table class=\"tdt-table\"><thead><tr><th>Size</th><th>Outer Dia. (mm)</th><th class=\"tdt-app\">Application Range (Advice)</th></tr></thead><tbody><tr class=\"tdt-bit-group\"><td colspan=\"3\">EX</td></tr><tr><td>SSR25/42</td><td>42</td><td class=\"tdt-app\">Sand, fills, gravel</td></tr><tr><td>SSR25/51</td><td>51</td><td class=\"tdt-app\"></td></tr><tr class=\"tdt-bit-group\"><td colspan=\"3\">EXX</td></tr><tr><td>SSR25/42</td><td>42</td><td class=\"tdt-app\">Softer sedimentary rocks such as marls, mudstones, siltstone</td></tr><tr><td>SSR25/51</td><td>51</td><td class=\"tdt-app\"></td></tr><tr class=\"tdt-bit-group\"><td colspan=\"3\">ES-F</td></tr><tr><td>SSR25/42</td><td>42</td><td class=\"tdt-app\">Gravel, soft rock</td></tr><tr><td>SSR25/51</td><td>57.5</td><td class=\"tdt-app\"></td></tr><tr class=\"tdt-bit-group\"><td colspan=\"3\">ESS-F</td></tr><tr><td>SSR25/42</td><td>42</td><td class=\"tdt-app\">Weathered rock, stone walls, rubble</td></tr><tr><td>SSR25/51</td><td>51</td><td class=\"tdt-app\"></td></tr><tr class=\"tdt-bit-group\"><td colspan=\"3\">EY</td></tr><tr><td>SSR25/51</td><td>51</td><td class=\"tdt-app\">Competent ground, strong rock</td></tr></tbody></table></div></div>"
 },
