 {
  "type": "text",
  "tag": "h2",
  "style": "h2",
  "html": "Hot-dip Galvanizing Rock Bolts System"
 },
 {
  "type": "text",
  "tag": "p",
  "style": "sm",
  "html": "Description:<br>Hot-dip galvanizing rock bolt is a sda rock bolt with good anti-corrosion property. It forms a protective layer by putting clean-surface products into molten galvanizing zinc, which has good effect on the anti-corrosion of steel."
 },
 {
  "type": "begin",
  "name": "Button"
 },
 {
  "type": "end",
  "name": "Button"
 },
 {
  "type": "end",
