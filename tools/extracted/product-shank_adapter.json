achine</th><th>Sinorock Hollow Anchor Bar</th><th>Outer Dia. (mm)</th><th>Length (mm)</th><th>Weight (kg)</th></tr></thead><tbody><tr><td>T38</td><td>R32</td><td>55</td><td>180</td><td>2.1</td></tr><tr><td>T38</td><td>T30</td><td>55</td><td>200</td><td>2.34</td></tr><tr><td>T38</td><td>T40</td><td>58</td><td>200</td><td>2.25</td></tr><tr><td>R32</td><td>R25</td><td>50</td><td>200</td><td>1.65</td></tr><tr><td>T45</td><td>R32</td><td>62</td><td>220</td><td>2.47</td></tr><tr><td>T38</td><td>R38</td><td>58</td><td>220</td><td>2.6</td></tr><tr><td>T45</td><td>R38</td><td>62</td><td>220</td><td>2.47</td></tr><tr><td>T45</td><td>T30</td><td>62</td><td>200</td><td>3.1</td></tr><tr><td>T38</td><td>R51</td><td>72</td><td>220</td><td>3.1</td></tr><tr><td>R32</td><td>T30</td><td>44</td><td>160</td><td>1</td></tr></tbody></table></div>"
