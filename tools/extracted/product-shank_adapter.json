 },
 {
  "type": "text",
  "tag": "h1",
  "style": "h3",
  "html": "<strong>Application</strong>"
 },
 {
  "type": "text",
  "tag": "p",
  "style": "body",
  "html": "Hot dip galvanizing anchor bolt is especially suitable for various acid, alkali mist and other corrosive environments, as well as occasions with longer service life requirements and complex environments in geotechnical engineering."
 },
